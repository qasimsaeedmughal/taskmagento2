<?xml version="1.0"?>
<!--
    Frontend-area DI configuration.
    Registers the ProductNamePlugin only for storefront requests.
    This prevents the badge suffix from appearing in admin grids or CLI output.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Catalog\Model\Product">
        <plugin name="custom_badge_product_name"
                type="Custom\Badge\Plugin\ProductNamePlugin"
                sortOrder="10"
                disabled="false"/>
    </type>
</config>

